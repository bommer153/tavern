# ======================================================================
# Tavern environment template. Copy per app:
#   apps/api/.env      <- API section
#   apps/web/.env.local <- WEB section
#   apps/mobile/.env   <- MOBILE section
# Never commit real secrets.
# ======================================================================

# ---------------------------- API ----------------------------
NODE_ENV=development
PORT=4000
# Must be a replica set (transactions). Local: `pnpm db:start`. Prod: MongoDB Atlas SRV URI.
MONGODB_URI=mongodb://127.0.0.1:27018/tavern?replicaSet=rs0
# >= 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false
# COOKIE_DOMAIN=.tavern.ph   # set when web and api share a parent domain
# SMTP (Laragon's Mailpit listens on 1025; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tavern <no-reply@tavern.local>
# LiveKit (voice). Leave empty to disable voice; rooms still work with text chat.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Payments: paymongo | dev (sandbox button, refused in production) | none
PAYMENT_PROVIDER=dev
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Media storage: local (dev only) | supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
EXPO_ACCESS_TOKEN=

# ---------------------------- WEB ----------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --------------------------- MOBILE --------------------------
# Use your machine's LAN IP so a physical device can reach the API.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:4000
